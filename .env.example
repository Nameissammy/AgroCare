# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI key for AI text generation fallback or primary use.
OPENAI_API_KEY=""

# AI_PROVIDER: Preferred provider for text generation tasks (chat + daily tip).
# Allowed values: gemini | openai | auto
# If both keys exist, fallback to the other provider on failure.
AI_PROVIDER="auto"

# Optional model overrides for text generation routes.
GEMINI_TEXT_MODEL="gemini-2.0-flash"
OPENAI_MODEL="gpt-4o-mini"

# APP_DEFAULT_LANGUAGE: Initial app language if browser/localStorage preference is unavailable.
# Allowed values: en | hi | ta | te | kn | ml | or
APP_DEFAULT_LANGUAGE="en"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for the Express auth server.
# Local default: mongodb://localhost:27017/agrocare
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/agrocare
MONGODB_URI="mongodb://localhost:27017/agrocare"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
# Use a long random string (32+ characters) in production.
JWT_SECRET="change-this-to-a-long-random-secret"

# RESET_TOKEN_EXPIRY_MINUTES: Password reset link validity window in minutes.
# APP_URL is used as the base URL for generated reset links.
RESET_TOKEN_EXPIRY_MINUTES="15"

# TIP_REFRESH_HOURS: Refresh interval for live Daily Farmer Tip endpoint cache.
# Defaults to 24 hours when not set.
TIP_REFRESH_HOURS="24"

# TIP_FALLBACK_RETRY_MINUTES: Retry window after AI failure before regenerating tip.
# Defaults to 60 minutes.
TIP_FALLBACK_RETRY_MINUTES="60"

# CORS_ORIGIN: Allowed origin for the API server (defaults to http://localhost:3000)
CORS_ORIGIN="http://localhost:3000"

# AGMARKNET_API_KEY: Optional key for Agmarknet/Data.gov.in mandi rates API.
# If not set, server uses a public demo key with stricter rate limits.
AGMARKNET_API_KEY=""
